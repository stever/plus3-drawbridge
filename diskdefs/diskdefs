# +3DOS / PCW 720K double-sided (sides alternating => 160 logical tracks)
diskdef plus3-720k
  seclen 512
  tracks 160
  sectrk 9
  blocksize 2048
  maxdir 256
  skew 1
  boottrk 1
  os 2.2
end
# standard +3 180K single-sided
diskdef plus3-180k
  seclen 512
  tracks 40
  sectrk 9
  blocksize 1024
  maxdir 64
  skew 1
  boottrk 1
  os 2.2
end
# Amstrad CPC formats as raw single-side images, sectors in logical order
diskdef cpcsys
  seclen 512
  tracks 40
  sectrk 9
  blocksize 1024
  maxdir 64
  skew 1
  boottrk 2
  os 2.2
end
diskdef cpcdata
  seclen 512
  tracks 40
  sectrk 9
  blocksize 1024
  maxdir 64
  skew 1
  boottrk 0
  os 2.2
end
